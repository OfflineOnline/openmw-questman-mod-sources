+-- MOD SOURCES (questSources.lua): ids the rules above can't place (no add-on) get a second chance. The
+-- fallback is injected by questProvider (keeps this module free of engine deps). It receives the lowercase
+-- id and returns { addon = slug, category = ... | faction = ... } or nil. Whatever the rules DID decide (category, faction)
+-- is kept; only the missing add-on is filled in.
+local fallback
+local function setFallback(fn) fallback = fn end
+
+local function get(id)
+    local r = ruled(id)
+    if (r and r.addon) or not fallback or not id then return r end
+    local f = fallback(id:lower())
+    if not f then return r end
+    local faction = (r and r.faction) or f.faction
+    local fe = faction and factions[faction]
+    return {
+        addon     = f.addon,
+        category  = (r and r.category) or f.category or (fe and fe.category),
+        faction   = faction,
+        factionId = (r and r.factionId) or (fe and fe.id),
+    }
+end
+
